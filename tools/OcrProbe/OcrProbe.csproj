<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>SnapOCR.OcrProbe</RootNamespace>
  </PropertyGroup>

  <!--
    诊断工具：直接链接生产代码，跑的是同一条 BitBlt → SoftwareBitmap → OCR 链路。
    不复制粘贴一份实现，避免「测的和跑的不是一套代码」。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\SnapOCR\Interop\NativeMethods.cs" Link="Linked\NativeMethods.cs" />
    <Compile Include="..\..\src\SnapOCR\Capture\DpiHelper.cs" Link="Linked\DpiHelper.cs" />
    <Compile Include="..\..\src\SnapOCR\Capture\MonitorEnumerator.cs" Link="Linked\MonitorEnumerator.cs" />
    <Compile Include="..\..\src\SnapOCR\Capture\ScreenCapture.cs" Link="Linked\ScreenCapture.cs" />
    <Compile Include="..\..\src\SnapOCR\Ocr\IOcrService.cs" Link="Linked\IOcrService.cs" />
    <Compile Include="..\..\src\SnapOCR\Ocr\TextComposer.cs" Link="Linked\TextComposer.cs" />
    <Compile Include="..\..\src\SnapOCR\Ocr\SoftwareBitmapFactory.cs" Link="Linked\SoftwareBitmapFactory.cs" />
    <Compile Include="..\..\src\SnapOCR\Ocr\WindowsOcrService.cs" Link="Linked\WindowsOcrService.cs" />
    <Compile Include="..\Shared\PngWriter.cs" Link="Shared\PngWriter.cs" />
  </ItemGroup>

</Project>
