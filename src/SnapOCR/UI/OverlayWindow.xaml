<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SnapOCR.UI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        覆盖层不用真透明窗口（WinAppSDK 2.7 已移除 TransparentBackdrop），
        而是把「热键按下那一瞬间的冻结帧」画满整屏，再用四块半透明矩形挖出选区。
        视觉上就是标准的截图遮罩，而且松手后 OCR 的正是用户看到的这张图。
    -->
    <Grid x:Name="Root" Background="#FF0B0B0B">
        <Image x:Name="FrameImage" Stretch="Fill" />

        <Canvas x:Name="MaskLayer" IsHitTestVisible="False">
            <Rectangle x:Name="MaskTop" Fill="#A6000000" />
            <Rectangle x:Name="MaskLeft" Fill="#A6000000" />
            <Rectangle x:Name="MaskRight" Fill="#A6000000" />
            <Rectangle x:Name="MaskBottom" Fill="#A6000000" />

            <Border
                x:Name="SelectionBorder"
                BorderBrush="#FF4CC2FF"
                BorderThickness="2"
                Visibility="Collapsed" />

            <Border
                x:Name="SizeBadge"
                Background="#E6101418"
                CornerRadius="6"
                Padding="10,3"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SizeText"
                    Foreground="#FFF2F6FA"
                    FontSize="13"
                    FontFamily="Consolas" />
            </Border>
        </Canvas>

        <Border
            x:Name="HintBadge"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,40,0,0"
            Background="#D9101418"
            CornerRadius="18"
            Padding="20,9">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    Glyph="&#xE7C3;"
                    FontSize="14"
                    Foreground="#FF7CC7FF"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="HintText"
                    Text="拖拽框选文字  ·  Esc 取消"
                    Foreground="#FFF2F6FA"
                    FontSize="14"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
